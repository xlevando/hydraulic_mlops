# Копируйте в .env и подставьте свои значения: `cp .env.example .env`
# Все переменные опциональны — по умолчанию приложение стартует как есть.

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Для локального запуска: localhost:5433 (порт из docker-compose)
# Для запуска в Docker: postgres:5432 (имя сервиса + внутренний порт)
DATABASE__URL=postgresql://postgres:postgres@localhost:5433/hydraulic_mlops

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Отладочный режим (влияет на echo SQL-запросов)
DEBUG=false

# Метка окружения для health-отчёта: development | staging | production
ENVIRONMENT=development